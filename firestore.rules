rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Only a single, non-enumerable field (redeemedCount) may be bumped by
    // exactly 1 without being an admin — this is what lets the customer-side
    // redemption transaction work with no login, while blocking anyone from
    // editing anything else on the pass (status, customerName, etc.).
    function isValidRedemptionIncrement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemedCount'])
        && request.resource.data.redeemedCount == resource.data.redeemedCount + 1;
    }

    // Backs the test-campaign reset feature below — true only if the redemption's
    // pass belongs to a campaign explicitly flagged isTest, checked server-side.
    function isTestCampaignRedemption(passToken) {
      let pass = get(/databases/$(database)/documents/passes/$(passToken)).data;
      let program = get(/databases/$(database)/documents/programs/$(pass.programId)).data;
      return program.isTest == true;
    }

    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /merchants/{merchantId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /passes/{passToken} {
      // A customer can only ever fetch their own pass by its exact token (get) —
      // that's what the pass link relies on and stays open, no login required.
      // Listing/querying the whole collection (list) is different: with no token
      // in hand it would let anyone pull every pass — including every
      // customerName — in one query, so that's admin-only.
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isValidRedemptionIncrement();
    }

    // Backs the human-readable pass number (e.g. "CP-0042") — admin-only,
    // since only the admin dashboard ever creates passes.
    match /counters/{counterId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // The core one-time-redemption guarantee: a redemption document's ID is
    // "{passToken}_{offerId}", so the SAME combination can only ever be
    // created once — Firestore itself refuses a second create at that ID,
    // even for two simultaneous requests. No server code required.
    match /redemptions/{redemptionId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/redemptions/$(redemptionId))
        && redemptionId == (request.resource.data.passToken + '_' + request.resource.data.offerId);
      // Discount savings are written once, at creation, as part of the redemption doc itself
      // (see the "create" rule above) — no separate permission needed for that.
      // This lets the customer optionally add a purchase total afterward, and correct it later
      // if they made a typo. For merchant-impact reporting only — it never changes what the
      // customer is told they saved, and it is the ONLY field a customer can ever change.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amountSpent'])
        && request.resource.data.amountSpent is number
        && request.resource.data.amountSpent >= 0;
      // Redemptions are permanent everywhere else in this app — that's what makes
      // a "Valid redemption" screen trustworthy to a merchant. This is a narrow,
      // deliberate exception: an admin may delete a redemption ONLY if the pass
      // it belongs to sits under a campaign explicitly flagged isTest. This is
      // verified here, server-side, against the real campaign data — not just
      // a button hidden in the admin UI — so it's structurally impossible to
      // reset redemption history on any real, live campaign's data.
      allow delete: if isAdmin() && isTestCampaignRedemption(resource.data.passToken);
    }

    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if false; // manage this collection from the console only
    }
  }
}
